System fireflyqak

Dispatch build : build( X )
Dispatch start : arg( NUM )
Dispatch cellstate : cellstate(X,Y,COLOR)     "set color of cell X,Y"
Dispatch sync : time( TIME )

Context ctxfirefly ip[host="localhost" port=8040]
Context ctxgrid ip [host="127.0.0.1" port=8050 ]

CodedQActor helper context ctxfirefly className "fireflyqak.helper"

QActor creator context ctxfirefly{ 
	[#val GRID_LEN = 20
		val GRID_SQ = GRID_LEN*GRID_LEN 
	#]
	State s0 initial{ 
   	 	[#  
		 clearlog("./logs/qakdemo26.log") 	//vedi src/main/resources/logback.xml
	 	#]
		println("$name : trying to create fireflies") color cyan
		forward helper -m start : start($GRID_SQ) //number of flies created
		[# logger.info(  "${currentState.stateName} Create actors 100 fireflys"  ) #]
		
	}
	Transition t0 whenTime 60000 -> end  
    			  whenMsg build -> buildFireflyActor
			
		
	State buildFireflyActor{
		printCurrentMessage color blue
		onMsg(build: build(X)){
			[# 
				val arg = payloadArg(0)
				val num = arg.toInt()
			#]
			create firefly _"$num"
			//println("$name : created: $num") color cyan
		}
	}Transition t0 whenTime 60000 -> end  
    			  whenMsg build -> buildFireflyActor
		
	State end{
    	[# logger.info(  "${currentState.stateName} ends"  ) #]
    	println("$name | SIMULATON ENDS") color magenta
    	[# System.exit(0) #]
    } 
}

ExternalQActor griddisplay context ctxgrid
	QActor firefly context ctxfirefly dynamicOnly {
	[#  
		val GRID_LEN = 20
		var num		= 0
	  	val id = name.substringAfterLast("_").toInt() - 1
	  	var Y = id % GRID_LEN 
	  	var X = id / GRID_LEN
	  	var Timer = java.util.Random().nextLong(500L,1000L ) 
	  	
 	#]
	State s0 initial{
		println("$name | Hi I'm alive, I blink every $Timer ms") color green
		println("$name | TEMPO ATTUALE: $Timer") color green
	}
	Goto handleBlink
	
	State handleBlink{
		[# 
			num ++  
		#]
		//TURN ON 
		//println("$name | $num light on ($X,$Y,1)") color yellow
		forward griddisplay -m cellstate : cellstate($X,$Y,1)
		
		//Gestione sincronizzazione: i dispatch per ogni vicino
		[#
			for(i in -1..1){
					for(j in -1..1){
						if (i == 0 && j == 0) continue  // salta se stesso
				        val nx = X + i
				        val ny = Y + j
				        if (nx >= 0 && nx < GRID_LEN && ny >= 0 && ny < GRID_LEN) {
				        	val id = nx * GRID_LEN + ny + 1
				            val neighborName = "firefly_${id}"
				            forward("sync", "time($Timer)", neighborName)
				        }
					}
				}
		#]
		
		delayVar Timer
		
		//TURN OFF
		//println("$name | $num light off ($X,$Y,0)") color black
		forward griddisplay -m cellstate : cellstate($X,$Y,0)
		
		
		//println("$name | TEMPO ATTUALE da blink: $Timer")
		
	}Transition t0
	    whenTimeVar Timer  -> handleBlink    // nessun sync in coda: nuovo ciclo
	    whenMsg     sync -> handleSync    // sync in coda: aggiorna Timer prima
		
	State handleSync{
		printCurrentMessage color blue
		onMsg(sync: time(TIME)){
			[# 
				val arg = payloadArg(0)
				val timeToShine = arg.toLong()
//				if(Timer<timeToShine)
//					Timer = timeToShine
				//sincronizzazione locale per propagazione
				Timer = (Timer + timeToShine)/2
			#]
			//println("$name | TEMPO ATTUALE da sync: $Timer")
			
		}
	}Transition t0 whenTime 50   -> handleBlink      // coda vuota: riparte
   		 whenMsg  sync -> handleSync       // svuota tutta la coda sync
		
}  


